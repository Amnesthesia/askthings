---
// The whole deck as plain HTML. This is the SEO surface and what unfurl
// crawlers (which run no JavaScript) see; game mode is a layer over it.
import Base from "../../layouts/Base.astro";
import CardBody from "../../components/CardBody.astro";
import GameDeck from "@react/components/GameDeck";
import { publishedDecks } from "../../common.ts";
import { cardHeadline, cardPath, deckPath, groupByTier, SITE_URL, type Deck } from "../../shared.ts";

export function getStaticPaths() {
	return publishedDecks().map((deck) => ({ params: { deck: deck.deck }, props: { deck } }));
}

interface Props {
	deck: Deck;
}
const { deck } = Astro.props;
const groups = [...groupByTier(deck).entries()];
const links = publishedDecks().map((d) => ({ deck: d.deck, name: d.name }));
// Levels are numbered, never named, in anything a player sees: the theme of a
// level is theirs to read, and it differs between decks. Names and
// descriptions exist in the JSON for the generation prompts only.
const description = `${deck.blurb} ${deck.cards.length} cards in ${deck.tiers.length} levels.`;
const schema = [
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: deck.name,
		description: deck.blurb,
		numberOfItems: deck.cards.length,
		itemListElement: deck.cards.map((card, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: cardHeadline(deck.kind, card),
			url: `${SITE_URL}${cardPath(deck.deck, card.id)}`,
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "askthings.lol", item: `${SITE_URL}/` },
			{ "@type": "ListItem", position: 2, name: deck.name, item: `${SITE_URL}${deckPath(deck.deck)}` },
		],
	},
];
---

<Base title={deck.name} description={description} path={deckPath(deck.deck)} schema={schema} deck={deck.deck}>
  <GameDeck client:load deck={deck} decks={links} />
  <h1>{deck.name}</h1>
  <p>{deck.blurb}</p>
  <section class="how-to-play">
    <h2>How to play</h2>
    <ol>{deck.play.howToPlay.map((line) => <li>{line}</li>)}</ol>
  </section>
  {groups.map(([tier, cards]) => (
    <section class="tier" data-tier={tier.level} id={`level-${tier.level}`}>
      <h2>Level {tier.level}</h2>
      <ol>
        {cards.map((card) => (
          <li>
            <a href={cardPath(deck.deck, card.id)}>
              <CardBody kind={deck.kind} card={card} />
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
