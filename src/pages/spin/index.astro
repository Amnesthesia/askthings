---
// A slot machine over every question on the site. The pool is whatever the
// filters allow; the island holds the machine, this page is its frame. The
// full list lives at /questions/, so there is nothing new here to index.
import SpinGame from "@react/components/SpinGame";
import { spinPool } from "../../common.ts";
import Base from "../../layouts/Base.astro";

const { decks, links, cards } = spinPool();
---

<Base
  title="Spin"
  description="A slot machine over every question on the site. Set the decks, the exposure range and the minimum scores, then spin."
  path="/spin/"
  noindex
>
  <SpinGame client:load src="/spin.json" decks={links} />
  <h1>Spin</h1>
  <p>One random question from {cards.length} across {decks.length} decks. Filter the pool by deck, exposure level and score, then spin. Filters stay in this browser.</p>
</Base>
