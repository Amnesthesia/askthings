---
import Base from "../layouts/Base.astro";
import { publishedDecks, spinPool } from "../common.ts";
import SpinGame from "@react/components/SpinGame";
import { deckPath } from "../shared.ts";

const decks = publishedDecks();
// The start page IS a game: Spin opens straight away when scripts run, one
// random question from every deck; the list below is what crawlers and no-JS
// readers get.
const spin = spinPool();
const total = decks.reduce((n, d) => n + d.cards.length, 0);
const description = `${total} questions across ${decks.length} decks — conversation games, starters and thought experiments for having a better conversation than you otherwise would.`;
const schema = [
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "Decks",
		numberOfItems: decks.length,
		itemListElement: decks.map((deck, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: deck.name,
			url: `https://askthings.lol${deckPath(deck.deck)}`,
		})),
	},
];
---

<Base title="Ask things" description={description} path="/" schema={schema}>
  {spin.cards.length > 0 && <SpinGame client:load src="/spin.json" decks={spin.links} />}
  <h1>Things to ask</h1>
  <p>Conversation games, conversation starters and thought experiments. Every deck escalates: start shallow, go as deep as the room allows.</p>
  <ul class="deck-list">
    {decks.map((deck) => (
      <li>
        <h2><a href={deckPath(deck.deck)}>{deck.name}</a></h2>
        <p>{deck.blurb}</p>
        <small>{deck.cards.length} cards · {deck.tiers.length} levels</small>
      </li>
    ))}
  </ul>
  <p><a href="/spin/">Spin for one random question</a> from a pool you choose, or <a href="/questions/">browse and filter every question</a> across all decks.</p>
</Base>
